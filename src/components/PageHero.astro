---
interface Props { eyebrow: string; title: string; text: string; image: string }
const { eyebrow, title, text, image } = Astro.props;
---
<section class="relative overflow-hidden bg-[#0A233A]">
  <img src={image} alt="" class="absolute inset-0 w-full h-full object-cover" />
  <div class="absolute inset-0 bg-gradient-to-r from-[#EAF2F7]/95 via-[#EAF2F7]/80 to-[#EAF2F7]/20"></div>
  <div class="relative max-w-7xl mx-auto px-6 py-16 md:py-24">
    <p class="text-[10.5px] md:text-[11px] font-bold tracking-[0.22em] uppercase text-[#71869A]">{eyebrow}</p>
    <h1 class="font-serif-display text-[36px] md:text-[52px] leading-[1.08] text-[#0F304E] mt-3 max-w-2xl">{title}</h1>
    <p class="text-[15px] text-[#334E66] leading-relaxed mt-4 max-w-xl">{text}</p>
  </div>
</section>
