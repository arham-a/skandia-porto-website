---
import Logo from "./Logo.astro";
import Icon from "./Icon.astro";
import { site } from "../data/site";
import { services } from "../data/services";
const quickLinks = [["Home","/"],["About","/about"],["Services","/services"],["Network","/network"],["Claims & Surveys","/claims-surveys"],["Insights","/insights"],["Contact","/contact"]];
---
<footer class="bg-[#0A233A] text-white">
  <div class="max-w-7xl mx-auto px-6 py-12 md:py-14 grid gap-10 md:grid-cols-2 lg:grid-cols-[1.4fr_0.8fr_1fr_1fr]">
    <div>
      <Logo light />
      <p class="text-[13px] leading-relaxed text-[#B9CFDE] mt-5 max-w-xs">Reliable and independent maritime services to shipowners, charterers, cargo interests, traders, insurers and logistics clients — worldwide.</p>
      <a href="/claims-surveys" class="inline-flex items-center gap-2 mt-5 text-[12px] font-semibold border border-[#3EA8BE] text-white px-4 py-2.5 hover:bg-[#3EA8BE] transition">24/7 Urgent Assistance <Icon name="arrowRight" size={14} /></a>
      <p class="text-[11px] text-[#5F8299] mt-6">Built with Astro + Tailwind CSS · Content driven from <span class="text-[#9FC6D6]">src/data</span></p>
    </div>
    <div>
      <h4 class="text-[13px] font-bold tracking-wide mb-4">Quick Links</h4>
      <ul class="space-y-2.5 text-[13px] text-[#B9CFDE]">{quickLinks.map(([l,p]) => <li><a href={p} class="hover:text-white hover:pl-1 transition-all">{l}</a></li>)}</ul>
    </div>
    <div>
      <h4 class="text-[13px] font-bold tracking-wide mb-4">Our Services</h4>
      <ul class="space-y-2.5 text-[13px] text-[#B9CFDE]">{services.map(s => <li><a href={`/services/${s.slug}`} class="hover:text-white hover:pl-1 transition-all">{s.title}</a></li>)}</ul>
    </div>
    <div>
      <h4 class="text-[13px] font-bold tracking-wide mb-4">Contact</h4>
      <ul class="space-y-3 text-[13px] text-[#B9CFDE]">
        <li class="flex gap-2.5"><span class="text-[#3EA8BE] shrink-0 mt-0.5"><Icon name="pin" size={15} /></span><span>Skandia Porto ApS<br/>Denmark</span></li>
        <li class="flex gap-2.5"><span class="text-[#3EA8BE] shrink-0 mt-0.5"><Icon name="mail" size={15} /></span><a href={`mailto:${site.email}`} class="hover:text-white">{site.email}</a></li>
        <li class="flex gap-2.5"><span class="text-[#3EA8BE] shrink-0 mt-0.5"><Icon name="phone" size={15} /></span><span>{site.phone}<br/><span class="text-white font-semibold">Urgent 24/7: {site.urgentPhone}</span></span></li>
      </ul>
      <a href={site.linkedin} target="_blank" rel="noreferrer" aria-label="LinkedIn" class="inline-flex w-9 h-9 mt-5 bg-[#0077B5] items-center justify-center hover:bg-[#3EA8BE] transition text-[15px] font-bold">in</a>
    </div>
  </div>
  <div class="border-t border-white/10 bg-[#061A2C]">
    <div class="max-w-7xl mx-auto px-6 py-4 flex flex-col sm:flex-row justify-between gap-2 text-[11.5px] text-[#8AA6BB]">
      <span>{site.copyright}</span>
      <span class="flex gap-2"><a href="/privacy" class="hover:text-white">Privacy Policy</a><span>|</span><a href="/terms" class="hover:text-white">Terms of Use</a></span>
    </div>
  </div>
</footer>
