---
interface Props { light?: boolean }
const { light = false } = Astro.props;
---
<a href="/" class="flex items-center gap-3 shrink-0" aria-label="Skandia Porto ApS — home">
  <svg width="52" height="34" viewBox="0 0 60 38" fill="none" class="shrink-0" aria-hidden="true">
    <path d="M4 22 C14 12, 24 28, 34 18 C42 10, 50 16, 56 12" stroke={light ? "#ffffff" : "#0F304E"} stroke-width="2.4" stroke-linecap="round"/>
    <path d="M4 29 C14 20, 24 34, 34 25 C42 18, 50 23, 56 19" stroke="#3EA8BE" stroke-width="2.4" stroke-linecap="round"/>
    <path d="M30 4 L34 14 L26 14 Z" fill={light ? "#ffffff" : "#0F304E"}/>
  </svg>
  <span class="leading-none">
    <span class={`block font-serif-display text-[19px] md:text-[21px] tracking-[0.08em] font-semibold ${light ? "text-white" : "text-[#0F304E]"}`}>SKANDIA PORTO <span class="text-[13px] align-top tracking-normal">ApS</span></span>
    <span class={`block text-[7.5px] md:text-[8px] tracking-[0.32em] mt-1 ${light ? "text-[#9FC6D6]" : "text-[#71869A]"}`}>MARITIME SOLUTIONS WORLDWIDE</span>
  </span>
</a>
