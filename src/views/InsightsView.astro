---
import PageHero from "../components/PageHero.astro";
import UrgentBanner from "../components/UrgentBanner.astro";
import ContactSection from "../components/ContactSection.astro";
import Icon from "../components/Icon.astro";
import { insights } from "../data/insights";
const cats = ["All", ...Array.from(new Set(insights.map(i => i.category)))];
---
  <main>
    <PageHero eyebrow="INSIGHTS" title="Practical Thinking From the Maritime Front Line" text="Notes on chartering, surveying, claims and logistics from our team and network — written for people who move ships and cargo." image="https://images.pexels.com/photos/12909048/pexels-photo-12909048.jpeg?auto=compress&cs=tinysrgb&fit=crop&h=627&w=1200" />
    <section class="max-w-7xl mx-auto px-6 py-12">
      <div class="flex flex-wrap gap-2 mb-9" id="insight-filters">
        {cats.map(c => <button data-filter={c} class={`cat-btn px-4 py-2 text-[12.5px] font-semibold border ${c === "All" ? "bg-[#0F304E] text-white border-[#0F304E]" : "border-[#D7E3EC] text-[#40596F]"}`}>{c}</button>)}
      </div>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6" id="insight-grid">
        {insights.map((a, idx) => (
          <a href={`/insights/${a.slug}`} data-category={a.category} class={`insight-card group border border-[#E6EFF4] bg-white hover:shadow-lg transition flex-col ${idx === 0 ? "md:col-span-2 lg:col-span-3 lg:grid lg:grid-cols-2" : "flex"}`}>
            <span class={`block overflow-hidden ${idx === 0 ? "aspect-[16/9] lg:aspect-auto lg:h-full" : "aspect-[16/9]"}`}><img src={a.image} alt="" class="w-full h-full object-cover group-hover:scale-105 transition duration-500" loading="lazy" /></span>
            <span class={`${idx === 0 ? "p-8 md:p-10 flex flex-col justify-center" : "p-6 flex flex-col flex-1"}`}>
              <span class="text-[10px] font-bold tracking-widest text-[#3EA8BE] uppercase">{idx === 0 ? "Featured · " : ""}{a.category} · {a.date}</span>
              <span class={`font-serif-display font-semibold text-[#0F304E] leading-tight ${idx === 0 ? "text-2xl md:text-[32px] mt-3" : "text-lg leading-snug mt-2"}`}>{a.title}</span>
              <span class={`text-[#667D92] leading-relaxed ${idx === 0 ? "text-sm mt-3" : "text-[13px] mt-2 flex-1 line-clamp-3"}`}>{a.excerpt}</span>
              <span class="flex items-center gap-4 text-xs text-[#71869A] mt-5"><span class="flex items-center gap-1"><Icon name="clock" size={13} />{a.readTime}</span><span class="font-bold text-[#0F304E] inline-flex items-center gap-1.5 ml-auto">Read Article <Icon name="arrowRight" size={13} /></span></span>
            </span>
          </a>
        ))}
      </div>
      <p id="insight-empty" class="hidden text-center text-[#71869A] py-16">No insights in this category yet.</p>

      <div class="mt-14 bg-[#0F304E] p-8 md:p-10 grid lg:grid-cols-2 gap-6 items-center">
        <div><h3 class="font-serif-display text-2xl text-white">Maritime insights, monthly. No noise.</h3><p class="text-sm text-[#B9CFDE] mt-2">One practical briefing a month on chartering, claims and surveying.</p></div>
        <form id="newsletter-form" class="flex gap-2">
          <input id="newsletter-email" type="email" placeholder="Your work email" class="flex-1 px-4 py-3.5 text-sm bg-white border-none min-w-0" />
          <button class="bg-[#3EA8BE] text-white text-sm font-bold px-6 shrink-0">Subscribe</button>
        </form>
        <p id="newsletter-ok" class="hidden text-white font-semibold bg-[#3EA8BE] px-5 py-4 text-sm">✓ Thank you — you're subscribed. Welcome aboard.</p>
      </div>
    </section>
    <UrgentBanner /><ContactSection compact />
  </main>
  <script>
    const btns = document.querySelectorAll<HTMLElement>(".cat-btn");
    const cards = document.querySelectorAll<HTMLElement>(".insight-card");
    const empty = document.getElementById("insight-empty");
    btns.forEach(b => b.addEventListener("click", () => {
      const f = b.dataset.filter;
      let n = 0;
      cards.forEach(c => { const show = f === "All" || c.dataset.category === f; c.classList.toggle("hidden", !show); if (show) n++; });
      empty?.classList.toggle("hidden", n !== 0);
      btns.forEach(x => { const active = x === b; x.className = `cat-btn px-4 py-2 text-[12.5px] font-semibold border ${active ? "bg-[#0F304E] text-white border-[#0F304E]" : "border-[#D7E3EC] text-[#40596F]"}`; });
    }));
    const form = document.getElementById("newsletter-form");
    form?.addEventListener("submit", (e) => {
      e.preventDefault();
      const email = (document.getElementById("newsletter-email") as HTMLInputElement).value;
      if (/^\S+@\S+\.\S+$/.test(email)) { form.classList.add("hidden"); document.getElementById("newsletter-ok")?.classList.remove("hidden"); }
    });
  </script>
