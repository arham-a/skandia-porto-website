---
import UrgentBanner from "../components/UrgentBanner.astro";
import ContactSection from "../components/ContactSection.astro";
import Icon from "../components/Icon.astro";
import { services, type Service } from "../data/services";

interface Props { service: Service }
const { service } = Astro.props;
const iconFor: Record<string, string> = { Anchor: "anchor", Package: "package", Search: "search", FileText: "fileText", Settings: "settings", Share2: "share" };
const others = services.filter(s => s.slug !== service.slug);
---
  <main>
    <section class="relative bg-[#0A233A] overflow-hidden">
      <img src={service.image} alt="" class="absolute inset-0 w-full h-full object-cover" />
      <div class="absolute inset-0 bg-gradient-to-r from-[#EAF2F7]/95 via-[#EAF2F7]/75 to-transparent"></div>
      <div class="relative max-w-7xl mx-auto px-6 py-16 md:py-20">
        <p class="flex flex-wrap items-center gap-1.5 text-[11px] font-bold tracking-widest text-[#5A7A93] uppercase">
          <a href="/" class="hover:text-[#0F304E]">Home</a><span>›</span><a href="/services" class="hover:text-[#0F304E]">Services</a><span>›</span><span class="text-[#3EA8BE]">{service.category}</span>
        </p>
        <div class="flex items-center gap-3 mt-5">
          <span class="w-12 h-12 bg-[#0F304E] text-white flex items-center justify-center"><Icon name={iconFor[service.icon]} size={24} /></span>
          <p class="text-[11px] font-bold tracking-[0.22em] uppercase text-[#71869A]">{service.category} Services</p>
        </div>
        <h1 class="font-serif-display text-4xl md:text-[52px] leading-[1.08] text-[#0F304E] mt-3 max-w-2xl">{service.title}</h1>
        <p class="text-[15px] text-[#334E66] leading-relaxed mt-4 max-w-xl">{service.excerpt}</p>
        <a href="/contact" class="inline-flex items-center gap-2 bg-[#0F304E] text-white text-[13px] font-semibold px-6 py-3.5 mt-7">Discuss a Requirement <Icon name="arrowRight" size={15} /></a>
      </div>
    </section>

    <section class="max-w-7xl mx-auto px-6 py-14 grid lg:grid-cols-[1fr_340px] gap-12">
      <div>
        <h2 class="font-serif-display text-3xl text-[#0F304E]">What we do</h2>
        <p class="text-[15px] leading-relaxed text-[#52667A] mt-4">{service.description}</p>
        <h3 class="font-serif-display text-2xl text-[#0F304E] mt-10">Scope of services</h3>
        <div class="grid sm:grid-cols-2 gap-3 mt-5">{service.features.map(f => <p class="flex gap-2.5 border border-[#E6EFF4] bg-[#F7FAFC] px-4 py-3.5 text-sm font-medium text-[#334E66]"><span class="text-[#3EA8BE] shrink-0"><Icon name="checkCircle" size={18} /></span>{f}</p>)}</div>
        <h3 class="font-serif-display text-2xl text-[#0F304E] mt-10">What you receive</h3>
        <div class="grid sm:grid-cols-3 gap-4 mt-5">{service.deliverables.map((d, i) => <div class="bg-[#0F304E] p-5"><p class="font-serif-display text-3xl text-[#3EA8BE]">0{i + 1}</p><p class="text-[13px] text-white leading-relaxed mt-2">{d}</p></div>)}</div>
        <div class="mt-10 border-l-4 border-[#3EA8BE] bg-[#E6EFF4] p-6">
          <p class="font-serif-display italic text-lg text-[#0F304E]">“Independent, practical and responsive — that's the standard we apply to every {service.shortTitle.toLowerCase()} instruction, large or small.”</p>
          <p class="text-xs font-bold tracking-wider text-[#71869A] mt-3">— SKANDIA PORTO TEAM, COPENHAGEN</p>
        </div>
      </div>
      <aside class="space-y-6 self-start lg:sticky lg:top-32">
        <div class="border border-[#E6EFF4] p-6">
          <h3 class="text-xs font-bold tracking-[0.18em] text-[#71869A]">ALL SERVICES</h3>
          <ul class="mt-4 divide-y divide-[#EEF3F6]">{others.map(s => <li><a href={`/services/${s.slug}`} class="flex justify-between items-center py-3 text-sm font-medium text-[#334E66] hover:text-[#3EA8BE]">{s.title}<Icon name="arrowRight" size={14} /></a></li>)}</ul>
        </div>
        <div class="bg-[#0A233A] p-6 text-white">
          <h3 class="font-serif-display text-xl">Need this service now?</h3>
          <p class="text-[13px] text-[#B9CFDE] leading-relaxed mt-2">Tell us the vessel, port and timeline — we'll confirm scope and attendance within the hour during business hours, 24/7 for urgent matters.</p>
          <a href="/contact" class="inline-flex items-center gap-2 bg-[#3EA8BE] text-white text-[13px] font-bold px-5 py-3 mt-5 w-full justify-center hover:bg-[#2F8EA5]">Request This Service <Icon name="arrowRight" size={14} /></a>
        </div>
      </aside>
    </section>
    <UrgentBanner /><ContactSection compact />
  </main>

