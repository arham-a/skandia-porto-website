---
import PageHero from "../components/PageHero.astro";
interface Props { type: "privacy" | "terms" }
const { type } = Astro.props;
const privacy = type === "privacy";
const sections: [string, string][] = privacy ? [
  ["Information we collect", "When you submit an enquiry we collect your name, email, company and message so we can respond. We do not sell personal data. Website usage is measured only in aggregated, anonymised form."],
  ["How we use it", "We use your information to respond to enquiries, provide our maritime services, comply with legal obligations and improve our website."],
  ["Your rights", "You may request access, correction or deletion of your personal data at any time by writing to info@skandiaporto.com. We respond within 30 days."],
  ["Data retention & security", "Enquiry data is retained only as long as necessary for the purpose collected and is stored with appropriate technical and organisational safeguards."],
] : [
  ["Use of this website", "Content on this website is provided for general information about Skandia Porto ApS and its services. It does not constitute legal, commercial or technical advice for any specific matter."],
  ["No engagement without instruction", "No client relationship is created by contacting us through this website until an engagement is expressly confirmed in writing."],
  ["Accuracy & liability", "We aim to keep information accurate and current, but make no warranty as to completeness. To the extent permitted by law, we accept no liability for reliance on website content."],
  ["Intellectual property", "All text, design and imagery on this site belong to Skandia Porto ApS or its licensors and may not be reproduced without permission."],
];
---
  <main>
    <PageHero eyebrow="SKANDIA PORTO ApS" title={privacy ? "Privacy Policy" : "Terms of Use"} text={privacy ? "How we collect, use and protect personal data when you use our website and services." : "The terms governing use of this website and the information provided on it."} image="https://images.pexels.com/photos/38569301/pexels-photo-38569301.jpeg?auto=compress&cs=tinysrgb&fit=crop&h=627&w=1200" />
    <article class="max-w-3xl mx-auto px-6 py-14 space-y-7 text-[14.5px] leading-[1.85] text-[#40596F]">
      {sections.map(([h, p]) => <section><h2 class="font-serif-display text-2xl text-[#0F304E]">{h}</h2><p class="mt-2">{p}</p></section>)}
      <p class="text-xs text-[#71869A] pt-4 border-t border-[#E6EFF4]">Last updated: January 2024 · Skandia Porto ApS, Denmark · info@skandiaporto.com</p>
    </article>
  </main>

